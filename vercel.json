{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "env": {
    "SUPABASE_URL": "https://llmxnpgjpxcvyrqjkfwb.supabase.co",
    "VITE_SUPABASE_URL": "https://llmxnpgjpxcvyrqjkfwb.supabase.co"
  },
  "build": {
    "env": {
      "SUPABASE_URL": "https://llmxnpgjpxcvyrqjkfwb.supabase.co",
      "VITE_SUPABASE_URL": "https://llmxnpgjpxcvyrqjkfwb.supabase.co"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
