  .row {
    display: flex;
    flex-wrap: wrap;
    margin-left: -15px;
    margin-right: -15px;
  }

  header .header {
    color: #212529;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    font-family: Open Sans, sans-serif;
    box-sizing: border-box;
    display: block;
  }

  .headerGov {
    color: #212529;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    font-family: Open Sans, sans-serif;
    box-sizing: border-box;
    display: block;
    padding-top: .5rem !important;
    padding-bottom: .5rem !important;
    background-color: #134175 !important;
  }

  .container,
  .container-fluid,
  .container-lg,
  .container-md,
  .container-sm,
  .container-xl {
    margin-left: auto;
    margin-right: auto;
    padding-left: 15px;
    padding-right: 15px;
    width: 100%;
  }

  .carousel-content,
  .position-relative,
  .search-box .search-form {
    position: relative !important;
  }

  .align-items-center,
  .header-link,
  .nav-item.md-link a,
  .site-desc {
    align-items: center !important;
  }

  .justify-content-end,
  .search-box {
    justify-content: flex-end !important;
  }

  .gap-1 {
    gap: .25rem;
  }

  .gap-3 {
    gap: 1rem;
  }

  .mr-2,
  .mx-2 {
    margin-right: .5rem !important;
  }

  .logo-titles,
  .pl-3,
  .post-type-post figcaption,
  .px-3,
  .sp-wrap-default,
  .sp-wrap-default .sp-head {
    padding-left: 1rem !important;
  }

  .header-link {
    gap: .325rem;
  }

  .d-inline-flex,
  .header-link,
  .nav-item.md-link a {
    display: inline-flex !important;
  }

  .btn-link {
    align-items: center;
    background-color: #0000;
    border: 1px solid #0000;
    border-radius: .25rem;
    color: #212529;
    display: inline-flex;
    font-size: 1rem;
    font-weight: 400;
    justify-content: center;
    line-height: 1.5;
    padding: .3rem .2rem;
    text-align: center;
  }

  #accessibility a .access-link,
  .bootstrap-datetimepicker-widget table td.day:not(.disabled),
  .btn-sair-mapa:hover,
  .headerGov .navbar-toggler,
  .links-governo,
  .links-governo a,
  .pagination .current,
  .search-box,
  .search-box .search-cancel,
  .search-box .search-icon,
  .search-box .search-input,
  .search-box .search-input::placeholder,
  .site-options,
  .site-options a,
  .socialItem:active,
  .text-white,
  footer .accessibility .botao {
    color: #fff !important;
  }

  .col {
    flex-basis: 0;
    flex-grow: 1;
    max-width: 100%;
  }

