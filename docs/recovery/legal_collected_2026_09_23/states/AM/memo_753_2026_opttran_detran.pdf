<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.spnc-row').forEach(function (row) {
        const col7 = row.querySelector('.spnc-col-7');
        const col9 = row.querySelector('.spnc-col-9');

        if (col7 && col9) {
            col7.classList.remove('spnc-col-7');
            col7.classList.add('spnc-col-6');

            col9.classList.remove('spnc-col-9');
            col9.classList.add('spnc-col-10');
        }
    });
});
</script>

<script>
/**
 * Substitui a URL de agendamento antiga pela nova (.jsp)
 */
const updateDetranLinks = () => {
    const oldUrl = "https://digital.detran.am.gov.br/public/agendamento";
    const newUrl = "https://digital.detran.am.gov.br/sga/apps/agendamento-servico/agendamento.jsp";

    // Busca todos os links que começam com a URL antiga ou são exatamente ela
    const links = document.querySelectorAll(`a[href^="${oldUrl}"]`);

    links.forEach(link => {
        link.href = newUrl;
        // Opcional: Log para conferência no console da equipe
        console.log(`[Link Updated] De: ${oldUrl} -> Para: ${newUrl}`);
    });
};

// 1. Executa assim que o DOM estiver pronto
document.addEventListener("DOMContentLoaded", updateDetranLinks);

// 2. Observer: Caso o Java/JSP injete o link dinamicamente após o load
const observer = new MutationObserver((mutations) => {
    updateDetranLinks();
});

observer.observe(document.body, {
    childList: true,
    subtree: true
});
</script>

<script>
	document.addEventListener('DOMContentLoaded', function() {
    const injectSVGs = () => {
        const images = document.querySelectorAll('img.svg-injector');
        
        images.forEach(img => {
            const imgURL = img.src;
            const imgClass = img.className;

            fetch(imgURL)
                .then(response => response.text())
                .then(data => {
                    const parser = new DOMParser();
                    const xmlDoc = parser.parseFromString(data, 'text/html');
                    const svg = xmlDoc.querySelector('svg');

                    if (svg) {
                        // Mantém as classes originais e adiciona uma para o CSS
                        svg.setAttribute('class', imgClass + ' replaced-svg');
                        // Remove cores fixas do arquivo original para o CSS dominar
                        svg.querySelectorAll('[fill]').forEach(el => el.removeAttribute('fill'));
                        
                        // Substitui a imagem pelo SVG real
                        img.parentNode.replaceChild(svg, img);
                    }
                });
        });
    };

    injectSVGs();
});
</script>		<script>
