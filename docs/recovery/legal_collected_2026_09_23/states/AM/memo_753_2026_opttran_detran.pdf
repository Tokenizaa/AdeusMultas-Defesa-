    <style>body #wrapper { background-color: #EEEEF5; }</style><style class="wpcode-css-snippet">.scroll-up {
    display: none !important;
}</style><script>(function () {
  if (window.__RV_WIDGET_LOADED__) return;
  window.__RV_WIDGET_LOADED__ = true;

  const RV = {
    voice: 'Brazilian Portuguese Female',
    zIndex: 9999999
  };

  // =========================
  // LOAD RESPONSIVEVOICE
  // =========================
  const script = document.createElement('script');
  script.src = 'https://code.responsivevoice.org/responsivevoice.js?key=HoGHbU9L';
  script.async = true;
  document.head.appendChild(script);

  script.onload = init;

  function init() {
    if (!window.responsiveVoice) return;

    responsiveVoice.cancel();

    injectStyles();
    createUI();
    bindEvents();
  }

  // =========================
  // STATE
  // =========================
  let state = {
    range: null,
    text: ''
  };

  let btnMain, panel, btnSelect;

  // =========================
  // UI
  // =========================
  function createUI() {
    btnMain = document.createElement('button');
    btnMain.id = 'rv-open';
    btnMain.innerHTML = iconSpeaker();
    document.body.appendChild(btnMain);

    panel = document.createElement('div');
    panel.id = 'rv-panel';
    panel.innerHTML = `
      <button id="rv-read">Ler página</button>
      <button id="rv-stop">Parar leitura</button>
      <button id="rv-close">${iconClose()}</button>
    `;
    document.body.appendChild(panel);

    btnSelect = document.createElement('button');
    btnSelect.id = 'rv-selection-button';
    btnSelect.innerHTML = iconSpeaker();
    document.body.appendChild(btnSelect);
  }

  // =========================
  // EVENTS
  // =========================
  function bindEvents() {

    // abrir painel
    btnMain.addEventListener('click', () => {
      panel.classList.toggle('active');
    });

    // eventos globais do painel (robusto com closest)
    document.addEventListener('click', (e) => {

      const closeBtn = e.target.closest('#rv-close');
      if (closeBtn) {
        panel.classList.remove('active');
      }

      const readBtn = e.target.closest('#rv-read');
      if (readBtn) {
        speak(document.body.innerText);
      }

      const stopBtn = e.target.closest('#rv-stop');
      if (stopBtn) {
        responsiveVoice.cancel();
      }
    });

    document.addEventListener('mouseup', handleSelection);
    document.addEventListener('scroll', hideSelectionButton, true);

    // clique leitura seleção (FIX DEFINITIVO)
    btnSelect.addEventListener('click', (e) => {
      e.preventDefault();

      if (!state.range || !state.text) return;

      const selection = window.getSelection();
      selection.removeAllRanges();
      selection.addRange(state.range);

      speak(state.text);
    });
  }

  // =========================
  // SELECTION (FIX RANGE)
  // =========================
  function handleSelection() {
    const selection = window.getSelection();

    if (!selection || selection.rangeCount === 0) {
      hideSelectionButton();
      return;
    }

    const text = selection.toString().trim();
    if (!text) {
      hideSelectionButton();
      return;
    }

    const range = selection.getRangeAt(0);

    // 🔥 freeze real selection
    state.range = range.cloneRange();
    state.text = text;

    const rect = range.getBoundingClientRect();

    positionSelectionButton(rect);
    showSelectionButton();
  }

  // =========================
  // POSITION
  // =========================
  function positionSelectionButton(rect) {
    const x = window.scrollX + rect.left + (rect.width / 2) - 20;
    const y = window.scrollY + rect.top - 45;

    btnSelect.style.left = `${x}px`;
    btnSelect.style.top = `${y}px`;
  }

  function showSelectionButton() {
    btnSelect.style.display = 'flex';
    requestAnimationFrame(() => btnSelect.classList.add('show'));
  }

  function hideSelectionButton() {
    btnSelect.classList.remove('show');
    btnSelect.classList.add('hide');

    setTimeout(() => {
      btnSelect.style.display = 'none';
      btnSelect.classList.remove('hide');
    }, 150);
  }

  // =========================
  // SPEECH
  // =========================
  function speak(text) {
    if (!text) return;
    responsiveVoice.cancel();
    responsiveVoice.speak(text, RV.voice);
  }

  // =========================
  // STYLE (GOV ROBUSTO)
  // =========================
  function injectStyles() {
    const style = document.createElement('style');

    style.innerHTML = `
      #rv-open, #rv-panel, #rv-selection-button {
        all: initial;
        font-family: Arial, sans-serif;
      }

      /* BOTÃO PRINCIPAL */
      #rv-open {
        position: fixed;
        left: 20px;
        bottom: 20px;

        width: 46px;
        height: 46px;

        background: #005a9c;
        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        cursor: pointer;
        z-index: ${RV.zIndex};

        /* ANIMAÇÃO ENTRADA */
        animation: rv-float-in 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      @keyframes rv-float-in {
        0% {
          transform: translateY(20px) scale(0.8);
          opacity: 0;
        }
        100% {
          transform: translateY(0) scale(1);
          opacity: 1;
        }
      }

      #rv-open svg {
        width: 22px;
        height: 22px;
        fill: #fff;
      }

      /* PAINEL */
      #rv-panel {
        position: fixed;
        left: 20px;
        bottom: 80px;

        background: #fff;
        padding: 10px;
        border-radius: 10px;

        box-shadow: 0 8px 24px rgba(0,0,0,.15);

        opacity: 0;
        transform: translateY(10px);
        pointer-events: none;

        transition: .2s ease;

        z-index: ${RV.zIndex};
      }

      #rv-panel.active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }

      #rv-panel button {
        display: block;
        width: 160px;

        margin: 6px 0;
        padding: 8px;

        border: none;
        border-radius: 6px;

        background: #005a9c;
        color: #fff;

        cursor: pointer;
      }

      /* BOTÃO FECHAR CORRIGIDO */
      #rv-close {
        width: 32px !important;
        height: 32px !important;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;
        background: #005a9c;
        border: none;
        cursor: pointer;
      }

      #rv-close svg {
        width: 16px !important;
        height: 16px !important;
        fill: #fff;
      }

      /* SELEÇÃO */
      #rv-selection-button {
        position: absolute;

        width: 40px;
        height: 40px;

        background: #005a9c;
        border-radius: 50%;

        display: none;
        align-items: center;
        justify-content: center;

        cursor: pointer;
        z-index: ${RV.zIndex};
      }

      #rv-selection-button svg {
        width: 18px;
        height: 18px;
        fill: #fff;
      }

      #rv-selection-button.show {
        opacity: 1;
        transform: scale(1);
      }

      #rv-selection-button.hide {
        opacity: 0;
        transform: scale(0.85);
      }
    `;

    document.head.appendChild(style);
  }

  // =========================
  // ICONS
  // =========================
  function iconSpeaker() {
    return `
      <svg viewBox="0 0 24 24">
        <path d="M3 10v4h4l5 4V6L7 10H3zm13.5 2a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/>
      </svg>
    `;
  }

  function iconClose() {
    return `
      <svg viewBox="0 0 24 24">
        <path d="M18.3 5.7L12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7 2.9 18.3 9.2 12 2.9 5.7 4.3 4.3l6.3 6.3 6.3-6.3z"/>
      </svg>
    `;
  }

})();</script><script
