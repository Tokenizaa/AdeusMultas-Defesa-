<script type="module">
  import Chatbot from 'https://sdk.ifdtech.com.br/detran-chatbot.js';

  Chatbot.initBubble({
    typebot: "detran-am-atendimento-base-de-conhecimento-paleta-detran-am-91tjei7",
    apiHost: "https://chatbot-viewer.ifdtech.com.br",
    theme: {
      button: {
        backgroundColor: "transparent",
        customIconSrc: "https://sdk.ifdtech.com.br/bot-helper-v6.png",
      },
    },
  });

  const LAUNCHER_IMG_SELECTOR = 'img[part="button-icon"][alt="Bubble button icon"]';
  const LAUNCHER_SIZE = '110px';

  function applyLauncherSize(root) {
    const img = root.querySelector(LAUNCHER_IMG_SELECTOR);
    if (!img)
      return;
    if (img.style.width !== LAUNCHER_SIZE) {
      img.style.setProperty('width', LAUNCHER_SIZE, 'important');
      img.style.setProperty('height', LAUNCHER_SIZE, 'important');
      img.style.setProperty('max-width', LAUNCHER_SIZE, 'important');
      img.style.setProperty('max-height', LAUNCHER_SIZE, 'important');
      img.style.setProperty("margin-right", "40px", "important");
      img.style.setProperty("margin-bottom", "40px", "important");
    }
  }

  function watchTypebotBubble() {
    const host = document.querySelector('typebot-bubble');
    const root = host && host.shadowRoot;
    if (!root)
      return false;
    applyLauncherSize(root);
    const obs = new MutationObserver(() => applyLauncherSize(root));
    obs.observe(root, {subtree: true, childList: true, attributes: true});
    return true;
  }

  let tries = 0;
  (function tick() {
    if (watchTypebotBubble() || tries++ > 300)
      return;
    requestAnimationFrame(tick);
  })();
</script><div vw class="enabled">
