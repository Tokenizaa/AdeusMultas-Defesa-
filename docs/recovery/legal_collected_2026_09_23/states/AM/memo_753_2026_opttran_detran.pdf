.spnc-sidebar .wc-block-featured-category__wrapper .wp-block-button__link:hover {color: #fff;background-color: #134175;}
.woocommerce .star-rating::before,.woocommerce .star-rating span::before {color: #134175;}
body .wc-block-components-review-list-item__rating>.wc-block-components-review-list-item__rating__stars span:before,
.woocommerce p.stars a{color: #134175;}
body .spnc-sidebar .wp-block-woocommerce-featured-category .wp-block-button__link{color: #fff;background-color: #134175;}
body .product-category .woocommerce-loop-category__title:hover{color:#134175;}

[data-theme="spnc_dark"] .newsblogger .woocommerce-loop-product__title:hover {color: #134175;}
[data-theme="spnc_dark"] .newsblogger.woocommerce .star-rating::before {color: #134175;}
[data-theme="spnc_dark"] .newsblogger.woocommerce .star-rating span::before {color: #134175;}
[data-theme="spnc_dark"] .newsblogger.woocommerce.single-product .product_meta .posted_in a {color: #134175;}
.newsblogger.woocommerce #review_form #respond .form-submit input{background-color: #134175;}
[data-theme="spnc_dark"] .woocommerce-loop-product__title:hover {color: #134175;}
[data-theme="spnc_dark"] .woocommerce .star-rating::before {color: #134175;}
[data-theme="spnc_dark"] .woocommerce .star-rating span::before {color: #134175;}
.format-quote a:hover{color: #134175;}
.wp-block-woocommerce-product-template li:hover .wp-block-button.wc-block-components-product-button .wc-block-components-product-button__button{
    background-color:#134175;
    color:#ffffff;
    border:1px solid #134175;
}
.wp-block-woocommerce-product-template .wp-block-button.wc-block-components-product-button .added_to_cart{
    background-color: #134175;
    color: #fff;
}
.search-panel input[type="search"] {border: 1px solid #134175;}
.shop-cat-menu .shop-cat-menu-head, .shop-product-search form button{
     background-color: #134175;
}
.shop-cat-menu .shop-cat-card-list a:is(:hover, :focus){
  color: #134175;
}
.shop-product-search .shop-product-cat-search .shop-category-list ul a:is(:hover, :focus){
  color: #134175;
}
.shop-product-search .shop-product-cat-search .shop-category-list .category-list-titl span.shop-cat-close i{
  background-color: #134175;
}
 .header-13 .spnc-custom .spnc-nav>.active>a,
 .header-13 .spnc-custom .spnc-nav>.active>a:hover,
.header-13 .spnc-custom .spnc-nav>.active>a:focus{
     color: #134175;
}

.header-13 .spnc-custom .header-cart.spnc-nav li > a.cart-icon .cart-count{
  background-color: #134175;
}
.header-13 .spnc-custom .header-cart.spnc-nav li > a.cart-icon{color: #000;}
.header-13 .spnc-custom .header-cart.spnc-nav li > a.cart-icon:hover{color: #134175;}
.uti-btns .shop-user a:is(:hover, :focus){
  color: #134175;
}
[data-theme="spnc_dark"] .shop-product-search .shop-product-cat-search .shop-category-list ul a:is(:hover, :focus) {
  color: #134175;
}
@media (max-width: 1100px) {
    .header-13 .spnc-custom .spnc-toggle {
        color: #134175;
    }
    body .header-13 .spnc-custom .spnc-nav > .active > a,
    body .header-13 .spnc-custom .spnc-nav > .active > a:hover,
    body .header-13 .spnc-custom .spnc-nav > .active > a:focus{
        color: #134175;
        background-color: transparent;
    }
    [data-theme="spnc_dark"] body.newscrunch #wrapper .header-sidebar.header-13 .spnc-custom .spnc-collapse .spnc-nav li.active > a {
        color: #134175;
        background-color: transparent;
    }
}
.shop-product-search .shop-product-cat-search .shop-category-list ul {
      scrollbar-color: #134175 #fff;
}
