# =============================================================================
# SUPABASE
# =============================================================================
SUPABASE_PROJECT_ID="your-project-id-here"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_ACCESS_TOKEN="YOUR_SUPABASE_ACCESS_TOKEN"

# Supabase client-side (Vite)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
VITE_SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
# =============================================================================
# CLOUDFLARE
# =============================================================================
CLOUDFLARE_ACCOUNT_ID="your-account-id-here"
CLOUDFLARE_API_TOKEN="YOUR_CLOUDFLARE_API_TOKEN"

# =============================================================================
# NVIDIA 
# =============================================================================
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"
NVIDIA_API_KEY_2="YOUR_NVIDIA_API_KEY_2"
NVIDIA_API_KEY_3="YOUR_NVIDIA_API_KEY_3"

# =============================================================================
# 9ROUTER (AI)
# =============================================================================
NINEROUTER_KEY="YOUR_NINEROUTER_KEY"
NINEROUTER_URL="https://api.9router.com"

# =============================================================================
# EVOLUTION API (WhatsApp Business)
# =============================================================================
# Porta do Docker (infra/docker/docker-compose.whatsapp.yml mapeia
#   ${EVOLUTION_PORT:-8080}:8080). Default 8080 — so altere se o compose for
#   subido com EVOLUTION_PORT diferente.
EVOLUTION_PORT="8080"
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="YOUR_EVOLUTION_API_KEY"
# Nome EXATO da instancia registrada na Evolution API (case-sensitive no
# endpoint /{instance}). A instancia real deste deploy chama-se `Defesai`.
# Se vazio, a app descobre o nome real em /instance/fetchInstances.
EVOLUTION_INSTANCE_NAME="Defesai"

# Secret de validacao de origem do webhook de entrada (OPCIONAL).
# Se setado: o endpoint /api/webhooks/whatsapp (e aliases) exige o custom header
#   X-Webhook-Secret com este valor em cada POST e rejeita com 401 os demais.
# Se vazio/ausente: validacao desativada (comportamento atual preservado em dev).
# IMPORTANTE: ao ativar, re-execute a configuracao do webhook
#   (POST /api/communication/whatsapp/webhook-config) para a Evolution API
#   passar o header X-Webhook-Secret junto — configureWebhook faz isso automaticamente.
EVOLUTION_WEBHOOK_SECRET="your-evolution-webhook-secret"

# Telefone de teste para validacao real de envio via Evolution API.
# Use um numero real com WhatsApp ativo. Formato: DDI+DDD+numero (ex: 5551994096322)
EVOLUTION_TEST_PHONE="5551994096322"

# =============================================================================
# MODO DA API
# =============================================================================
VITE_API_MODE="real"

# =============================================================================
# E2E ADMIN TESTE
# =============================================================================
ADMIN_TEST_LOGIN="admin-test@example.com"
ADMIN_TEST_PASSWORD="admin-test-password"

# =============================================================================
# E2E USER TESTE
# =============================================================================
USER_TEST_LOGIN="user-test@example.com"
USER_TEST_PASSWORD="user-test-password"

# =============================================================================
# PAGBANK
# =============================================================================
PAGBANK_TOKEN="YOUR_PAGBANK_TOKEN"
PAGBANK_ENV="sandbox"
PAGBANK_WEBHOOK_SECRET="YOUR_PAGBANK_WEBHOOK_SECRET"
# For production, use: PAGBANK_ENV="production"

# PAYMENT_MODE: Define se o sistema opera em produção (dinheiro real) ou sandbox (testes).
#   'sandbox' — Testes seguros, PagBank sandbox, auth bypass para E2E
#   'production' — Transações reais, GGPIXAPI obrigatório, auth obrigatório, webhook secrets obrigatórios
# IMPORTANT: Em produção, PagBank é BLOQUEADO como gateway ativo.
PAYMENT_MODE="sandbox"

# =============================================================================
# GGPIXAPI (Production Gateway)
# =============================================================================
# PAYMENT_ACTIVE_GATEWAY: Which gateway to use for new PIX charges.
#   'pagbank' — PIX + Credit Card (PagBank/PagSeguro) - FOR TESTING/SANDBOX ONLY
#   'ggpixapi' — PIX In only (GGPIXAPI) - RECOMMENDED FOR PRODUCTION
# IMPORTANT: Switching gateway does NOT migrate existing payments.
PAYMENT_ACTIVE_GATEWAY="ggpixapi"

# GGPIX_API_KEY: API key for GGPIXAPI (used in X-API-Key header server-side only).
# Get from: https://app.ggpixapi.com/ (Settings → API Keys)
# Required in production when using GGPIX gateway
GGPIX_API_KEY="YOUR_GGPIX_API_KEY"

# GGPIX_ENABLED: Set to 'true' to enable GGPIXAPI as an available gateway.
# In production: set to 'true'
# In testing only: can be 'false' if using PagBank
GGPIX_ENABLED="false"

# GGPIX_WEBHOOK_ALLOWED_IPS: Comma-separated list of allowed IPs/CIDR for GGPIXAPI webhooks.
# Required in production for security (GGPIXAPI doesn't use HMAC signatures).
# Get IPs from GGPIXAPI documentation or support.
GGPIX_WEBHOOK_ALLOWED_IPS=""

# =============================================================================
# MEDIA GENERATION SERVICE (Modular & Decoupled AI Media Architecture)
# =============================================================================
# MEDIA_PROVIDER: 'auto' | 'remote' | 'local' | 'dev_mock'
MEDIA_PROVIDER=auto
MEDIA_IMAGE_PROVIDER=auto
MEDIA_VIDEO_PROVIDER=auto
MEDIA_I2V_PROVIDER=auto

# Local generation switch (only enable if GPU/CUDA hardware is available)
MEDIA_LOCAL_ENABLED=false
MEDIA_LOCAL_ENDPOINT="http://127.0.0.1:8000"

# Remote cloud generation (Gemini / Imagen / Veo / Remote Worker)
MEDIA_REMOTE_ENABLED=true

# Concurrency control for background media jobs
MEDIA_MAX_CONCURRENT_JOBS=2

# =============================================================================
# META GRAPH API & OAUTH (Production Infrastructure)
# =============================================================================
META_APP_ID="your-meta-app-id-here"
META_APP_SECRET="YOUR_META_APP_SECRET"
META_ACCESS_TOKEN="YOUR_META_SYSTEM_USER_OR_PAGE_ACCESS_TOKEN"
META_PAGE_ID="your-facebook-page-id-here"
INSTAGRAM_ACCOUNT_ID="your-instagram-business-account-id-here"
META_REDIRECT_URI="https://www.defesai.shop/api/integrations/meta/callback"
META_WEBHOOK_VERIFY_TOKEN="your-meta-webhook-verify-token"
META_GRAPH_API_VERSION="v20.0"
FACEBOOK_APP_ID="your-meta-app-id-here"
FACEBOOK_APP_SECRET="YOUR_FACEBOOK_APP_SECRET"
FACEBOOK_REDIRECT_URI="https://www.defesai.shop/api/integrations/meta/callback"

# E2E TEST CREDENTIALS
E2E_USER="test@example.com"
E2E_PASSWORD="test-password"
E2E_ADMIN_USER="admin@example.com"
E2E_ADMIN_PASSWORD="admin-password"

# =============================================================================
# DOCUMENSO (Digital Signatures)
# =============================================================================
# Documenso API v2 base URL (self-hosted or cloud)
# Self-hosted: http://localhost:3000 (or your Docker hostname)
# Cloud: https://app.documenso.com
DOCUMENSO_BASE_URL="https://app.documenso.com"

# Documenso API Token (from Settings → API Tokens)
DOCUMENSO_API_TOKEN="your-documenso-api-token"

# Webhook secret for HMAC-SHA256 verification (from Settings → Webhooks)
DOCUMENSO_WEBHOOK_SECRET="your-documenso-webhook-secret"

# Your webhook endpoint URL (must be publicly accessible)
# Format: https://your-domain.com/api/documenso/webhook
DOCUMENSO_WEBHOOK_URL="https://your-domain.com/api/documenso/webhook"
