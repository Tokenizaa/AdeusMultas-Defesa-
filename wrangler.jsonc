{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "adeusmulta",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "adeusmulta-knowledge"
    }
  ],
  "ratelimits": [
    {
      "name": "ANONYMOUS_CASE_LIMITER",
      "namespace_id": "2026101301",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN_PRIMARY": "https://adeusmulta.defesai.com.br",
    "SUPABASE_URL": "https://llmxnpgjpxcvyrqjkfwb.supabase.co"
  },
  "build": {
    "command": "bun run build"
  }
}
