{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "adeusmulta",
  "main": "cloudflare/dist/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "adeusmulta-knowledge"
    }
  ],
  "ratelimits": [
    {
      "name": "ANONYMOUS_CASE_LIMITER",
      "namespace_id": "2026101301",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * 1"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "API_ORIGIN_PRIMARY": "https://adeusmulta.defesai.com.br",
    "SUPABASE_URL": "https://llmxnpgjpxcvyrqjkfwb.supabase.co",
    "PAGBANK_ENV": "production",
    "PAYMENT_MODE": "production",
    "VENO_PRIMARY_GATEWAY": "venopag"
  },
  "build": {
    "command": "npx esbuild cloudflare/worker.js --bundle --platform=node --format=esm --outfile=cloudflare/dist/worker.js --alias:qrcode=./cloudflare/stubs/qrcode.js --target=node18"
  }
}

