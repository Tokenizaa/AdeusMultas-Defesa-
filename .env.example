# =============================================================================
# SUPABASE
# =============================================================================
SUPABASE_PROJECT_ID="your-project-id-here"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_ACCESS_TOKEN="your-access-token-here"

# Supabase client-side (Vite)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
VITE_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
# =============================================================================
# CLOUDFLARE
# =============================================================================
CLOUDFLARE_ACCOUNT_ID="your-account-id-here"
CLOUDFLARE_API_TOKEN="your-api-token-here"

# =============================================================================
# NVIDIA 
# =============================================================================
NVIDIA_API_KEY="your-nvidia-api-key-here"
NVIDIA_API_KEY_2="your-nvidia-api-key-2-here"
NVIDIA_API_KEY_3="your-nvidia-api-key-3-here"

# =============================================================================
# 9ROUTER (AI)
# =============================================================================
NINEROUTER_KEY="your-9router-key-here"
NINEROUTER_URL="https://api.9router.com"

# =============================================================================
# EVOLUTION API (WhatsApp Business)
# =============================================================================
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key-here"
EVOLUTION_INSTANCE="your-instance-id-here"
EVOLUTION_INSTANCE_NAME="your-instance-name-here"
EVOLUTION_INSTANCE_PHONE="your-phone-number-here"
EVOLUTION_INSTANCE_USER="your-instance-user-here"

# =============================================================================
# MODO DA API
# =============================================================================
VITE_API_MODE="real"

# =============================================================================
# E2E ADMIN TESTE
# =============================================================================
ADMIN_TEST_LOGIN="admin-test@example.com"
ADMIN_TEST_PASSWORD="admin-test-password"

# =============================================================================
# E2E USER TESTE
# =============================================================================
USER_TEST_LOGIN="user-test@example.com"
USER_TEST_PASSWORD="user-test-password"

# =============================================================================
# PAGBANK
# =============================================================================
PAGBANK_TOKEN="your-pagbank-token-here"
PAGBANK_ENV="sandbox"
# For production, use: PAGBANK_ENV="production"

# =============================================================================
# GGPIXAPI (Production Gateway)
# =============================================================================
# PAYMENT_ACTIVE_GATEWAY: Which gateway to use for new PIX charges.
#   'pagbank' — PIX + Credit Card (PagBank/PagSeguro) - FOR TESTING ONLY
#   'ggpixapi' — PIX In only (GGPIXAPI) - RECOMMENDED FOR PRODUCTION
# IMPORTANT: Switching gateway does NOT migrate existing payments.
PAYMENT_ACTIVE_GATEWAY="pagbank"

# GGPIX_API_KEY: API key for GGPIXAPI (used in X-API-Key header server-side only).
# Get from: https://app.ggpixapi.com/ (Settings → API Keys)
# Required in production when using GGPIX gateway
GGPIX_API_KEY="your-ggpix-api-key-here"

# GGPIX_ENABLED: Set to 'true' to enable GGPIXAPI as an available gateway.
# In production: set to 'true'
# In testing only: can be 'false' if using PagBank
GGPIX_ENABLED="false"

# =============================================================================
# META GRAPH API & OAUTH (Production Infrastructure)
# =============================================================================
META_APP_ID="your-meta-app-id-here"
META_APP_SECRET="your-meta-app-secret-here"
META_REDIRECT_URI="https://defesai.com.br/api/integrations/meta/callback"
META_WEBHOOK_VERIFY_TOKEN="your-meta-webhook-verify-token"
META_GRAPH_API_VERSION="v20.0"
FACEBOOK_APP_ID="your-meta-app-id-here"
FACEBOOK_APP_SECRET="your-meta-app-secret-here"
FACEBOOK_REDIRECT_URI="https://defesai.com.br/api/integrations/meta/callback"

# E2E TEST CREDENTIALS
E2E_USER="test@example.com"
E2E_PASSWORD="test-password"
E2E_ADMIN_USER="admin@example.com"
E2E_ADMIN_PASSWORD="admin-password"
